#!/usr/bin/env bash
set -euo pipefail

DB_USER="${PGUSER:-$(whoami)}"
DB_HOST="${PGHOST:-localhost}"
DB_PORT="${PGPORT:-5432}"
CONFIG_FILE="flyway.properties"
CONFIG_VAR="flyway.url"
BRANCH=$(git branch --show-current)
ROOT=$(git rev-parse --show-toplevel)
DB_NAME=""

main_db() { printf '%s' "$DB_NAME"; }
copy_db() {
  if [ "$BRANCH" = "main" ]; then
    main_db
  else
    printf '%s-%s' "$(main_db)" "$BRANCH"
  fi
}
config_path() { printf '%s/%s' "$ROOT" "$CONFIG_FILE"; }
jdbc_url() { printf 'jdbc:postgresql://%s:%s/%s' "$DB_HOST" "$DB_PORT" "$1"; }

db_conf_path() { printf '%s/.git/db-tool.conf' "$ROOT"; }
load_db_name() {
  local f saved
  f=$(db_conf_path)
  [ -f "$f" ] || return 0
  saved=$(head -n 1 "$f")
  [ -n "$saved" ] && DB_NAME="$saved"
  return 0
}

save_db_name() { printf '%s\n' "$1" > "$(db_conf_path)"; }

ask() {
  psql -X -q -t -A -P pager=off \
       -U "$DB_USER" -h "$DB_HOST" -p "$DB_PORT" -d postgres -c "$1"
}

require_connection() {
  if ! ask 'SELECT 1' >/dev/null 2>&1; then
    echo "FAIL  cannot reach postgres as $DB_USER@$DB_HOST:$DB_PORT" >&2
    echo "      is it running?   brew services start postgresql@16" >&2
    echo "      wrong user?      run 'whoami' and set PGUSER, or edit DB_USER" >&2
    exit 1
  fi
}

db_exists() {
  [ "$(ask "SELECT 1 FROM pg_database WHERE datname = '$1'")" = "1" ]
}

# PostgreSQL refuses to copy or drop a database while anyone is connected to
# it. pid <> pg_backend_pid() excludes our own session.
disconnect_everyone_from() {
  local name="$1" open
  open=$(ask "SELECT count(*) FROM pg_stat_activity
              WHERE datname = '$name' AND pid <> pg_backend_pid()")
  if [ "${open:-0}" -gt 0 ]; then
    echo "      closing $open connection(s) to \"$name\""
    ask "SELECT pg_terminate_backend(pid) FROM pg_stat_activity
         WHERE datname = '$name' AND pid <> pg_backend_pid()" >/dev/null
    sleep 1
  fi
}

get_prop() {
  local file="$1" key="$2"
  KEY="$key" awk '
    /^[ \t]*[#!]/ { next }
    { p = index($0, "=")
      if (p > 0) {
        k = substr($0, 1, p - 1); gsub(/^[ \t]+|[ \t]+$/, "", k)
        if (k == ENVIRON["KEY"]) { v = substr($0, p + 1); gsub(/^[ \t]+/, "", v); found = v }
      } }
    END { if (found != "") print found }
  ' "$file"
}

set_prop() {
  local file="$1" key="$2" value="$3" tmp
  tmp=$(mktemp "${TMPDIR:-/tmp}/db-tool.XXXXXX")
  KEY="$key" VAL="$value" awk '
    BEGIN { k = ENVIRON["KEY"]; v = ENVIRON["VAL"]; written = 0 }
    /^[ \t]*[#!]/ { print; next }
    { p = index($0, "=")
      if (p > 0) {
        key = substr($0, 1, p - 1); gsub(/^[ \t]+|[ \t]+$/, "", key)
        if (key == k) { if (!written) { print k "=" v; written = 1 } next }
      }
      print }
    END { if (!written) print k "=" v }
  ' "$file" > "$tmp"
  cat "$tmp" > "$file"    # copy back, so permissions and inode survive
  rm -f "$tmp"
}

cmd_copy() {
  local main copy cfg old new
  main=$(main_db)
  copy=$(copy_db)
  cfg=$(config_path)

  require_connection

  if db_exists "$main"; then
    echo "yes - database \"$main\" exists"
  else
    echo "no  - database \"$main\" does not exist"
    echo "      create it with: createdb $main"
    exit 1
  fi

  if [ ! -f "$cfg" ]; then
    echo "no  - config file $CONFIG_FILE not found"
    [ -f "$cfg.example" ] && echo "      copy it first: cp $CONFIG_FILE.example $CONFIG_FILE"
    exit 1
  fi

  if db_exists "$copy"; then
    echo "      \"$copy\" already exists, keeping it"
  else
    disconnect_everyone_from "$main"
    echo "      copying \"$main\" -> \"$copy\""
    ask "CREATE DATABASE \"$copy\" TEMPLATE \"$main\"" >/dev/null
    echo "      created \"$copy\""
  fi

  old=$(get_prop "$cfg" "$CONFIG_VAR")
  new=$(jdbc_url "$copy")
  set_prop "$cfg" "$CONFIG_VAR" "$new"

  echo "      $CONFIG_VAR"
  echo "        was: ${old:-<not set>}"
  echo "        now: $(get_prop "$cfg" "$CONFIG_VAR")"

  # cheap self-check: did the file really end up saying what we intended?
  [ "$(get_prop "$cfg" "$CONFIG_VAR")" = "$new" ] || {
    echo "      WRITE FAILED - $CONFIG_FILE does not contain the new value" >&2
    exit 1
  }
}

cmd_cleanup() {
  local main cfg new victims name
  require_connection

  main=$(main_db)
  cfg=$(config_path)

  victims=$(ask "SELECT datname FROM pg_database
                 WHERE starts_with(datname, '$main-')
                   AND datname <> '$main'
                 ORDER BY datname")

  if [ -z "$victims" ]; then
    echo "      nothing to drop - only \"$main\" exists"
  else
    while IFS= read -r name; do
      [ -n "$name" ] || continue
      [ "$name" = "$main" ] && continue
      disconnect_everyone_from "$name"
      dropdb --force -U "$DB_USER" -h "$DB_HOST" -p "$DB_PORT" "$name"
      echo "      dropped \"$name\""
    done <<< "$victims"
  fi

  new=$(jdbc_url "$main")
  set_prop "$cfg" "$CONFIG_VAR" "$new"
  echo "      $CONFIG_VAR now: $(get_prop "$cfg" "$CONFIG_VAR")"
}

cmd_init() {
  local root hooks hook sample main cfg new
  require_connection

  root="$ROOT"
  hooks="$root/.git/hooks"
  hook="$hooks/post-checkout"
  sample="$hook.sample"
  main=$(main_db)
  cfg=$(config_path)
  new=$(jdbc_url "$main")
  set_prop "$cfg" "$CONFIG_VAR" "$new"
  echo "url=$(get_prop "$cfg" "$CONFIG_VAR")"

  if [ -e  "$sample" ] && [ -e "$hook" ]; then
    mv "$sample" "$hook"
  fi

  cat > "$hook" <<EOF
#!/usr/bin/env bash
# Installed by db-tools-v2
[ "\$3" = "1" ] || exit 0
branch=\$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)
"$root/db-tool-v2" copy || true
EOF
  chmod +x "$hook"
  echo "Hook activated"
}

load_db_name
COMMAND="${1:-}"
if [ $# -gt 0 ]; then shift; fi    # drop the command, leaving only the flags

while [ $# -gt 0 ]; do
  case "$1" in
    --dbname)
      if [ $# -lt 2 ]; then
        echo "FAIL  --dbname needs a value" >&2
        exit 1
      fi
      DB_NAME="$2"
      save_db_name "$DB_NAME"
      shift 2
      ;;
    --dbname=*)
      DB_NAME="${1#--dbname=}"
      save_db_name "$DB_NAME"
      shift
      ;;
    *)
      echo "FAIL  unexpected argument: $1" >&2
      echo "usage: $0 [init|cleanup] [--dbname NAME]" >&2
      exit 1
      ;;
  esac
done

 case "$DB_NAME" in
   *[!A-Za-z0-9_-]*) echo "FAIL  name may only contain letters, digits, _ and -" >&2; exit 1 ;;
 esac

case "$COMMAND" in
  init)    cmd_init ;;
  cleanup) cmd_cleanup ;;
  copy)    cmd_copy ;;
  *)       echo "usage: $0 [init|cleanup] [--dbname NAME]" >&2; exit 1 ;;
esac