#!/usr/bin/env bash
set -euo pipefail

DB_USER="${PGUSER:-$(whoami)}"
DB_HOST="${PGHOST:-localhost}"
DB_PORT="${PGPORT:-5432}"
CONFIG_FILE="flyway.properties"
CONFIG_VAR="flyway.url"
BRANCH=$(git branch --show-current)
ROOT=$(git rev-parse --show-toplevel)
DB_NAME=""

main_db() { printf '%s' "$DB_NAME"; }
copy_db() {
  if [ "$BRANCH" = "main" ]; then
    main_db
  else
    printf '%s-%s' "$(main_db)" "${BRANCH//\//-}"
  fi
}
config_path() { printf '%s/%s' "$ROOT" "$CONFIG_FILE"; }
jdbc_url() { printf 'jdbc:postgresql://%s:%s/%s' "$DB_HOST" "$DB_PORT" "$1"; }

ask() {
  psql --no-psqlrc --quiet --tuples-only --no-align --pset=pager=off \
       --username="$DB_USER" --host="$DB_HOST" --port="$DB_PORT" --dbname=postgres --command="$1"
}

require_connection() {
  if ! ask 'SELECT 1' >/dev/null 2>&1; then
    echo "FAIL  cannot reach postgres as $DB_USER@$DB_HOST:$DB_PORT" >&2
    echo "      is it running?   brew services start postgresql@16" >&2
    echo "      wrong user?      run 'whoami' and set PGUSER, or edit DB_USER" >&2
    exit 1
  fi
}

valid_name() {
  case "$1" in
    "")               echo "FAIL  missing template database name" >&2; return 1 ;;
    *[!A-Za-z0-9_-]*) echo "FAIL  '$1' - letters, digits, _ and - only" >&2; return 1 ;;
  esac
  return 0
}

db_exists() {
  [ "$(ask "SELECT 1 FROM pg_database WHERE datname = '$1'")" = "1" ]
}

# PostgreSQL refuses to copy or drop a database while anyone is connected to
# it. pid <> pg_backend_pid() excludes our own session.
disconnect_everyone_from() {
  local name="$1" open
  open=$(ask "SELECT count(*) FROM pg_stat_activity
              WHERE datname = '$name' AND pid <> pg_backend_pid()")
  if [ "${open:-0}" -gt 0 ]; then
    echo "      closing $open connection(s) to \"$name\""
    ask "SELECT pg_terminate_backend(pid) FROM pg_stat_activity
         WHERE datname = '$name' AND pid <> pg_backend_pid()" >/dev/null
    sleep 1
  fi
}

get_prop() {
  local file="$1" key="$2"
  KEY="$key" awk '
    /^[ \t]*[#!]/ { next }
    { p = index($0, "=")
      if (p > 0) {
        k = substr($0, 1, p - 1); gsub(/^[ \t]+|[ \t]+$/, "", k)
        if (k == ENVIRON["KEY"]) { v = substr($0, p + 1); gsub(/^[ \t]+/, "", v); found = v }
      } }
    END { if (found != "") print found }
  ' "$file"
}

set_prop() {
  local file="$1" key="$2" value="$3" tmp
  [ -f "$file" ] || : > "$file"
  tmp=$(mktemp "${TMPDIR:-/tmp}/db-tool.XXXXXX")
  KEY="$key" VAL="$value" awk '
    BEGIN { k = ENVIRON["KEY"]; v = ENVIRON["VAL"]; written = 0 }
    /^[ \t]*[#!]/ { print; next }
    { p = index($0, "=")
      if (p > 0) {
        key = substr($0, 1, p - 1); gsub(/^[ \t]+|[ \t]+$/, "", key)
        if (key == k) { if (!written) { print k "=" v; written = 1 } next }
      }
      print }
    END { if (!written) print k "=" v }
  ' "$file" > "$tmp"
  cat "$tmp" > "$file"
  rm -f "$tmp"
}

cmd_copy() {
  local main copy cfg old new
  DB_NAME="$1"
  require_connection
  main=$(main_db)
  copy=$(copy_db)
  cfg=$(config_path)


  if db_exists "$main"; then
    echo "yes - database \"$main\" exists"
  else
    echo "no  - database \"$main\" does not exist"
    echo "      create it with: createdb $main"
    exit 1
  fi

  if [ ! -f "$cfg" ]; then
    echo "no  - config file $CONFIG_FILE not found"
    [ -f "$cfg.example" ] && echo "      copy it first: cp $CONFIG_FILE.example $CONFIG_FILE"
    exit 1
  fi

  if db_exists "$copy"; then
    echo "      \"$copy\" already exists, keeping it"
  else
    disconnect_everyone_from "$main"
    echo "      copying \"$main\" -> \"$copy\""
    ask "CREATE DATABASE \"$copy\" TEMPLATE \"$main\"" >/dev/null
    echo "      created \"$copy\""
  fi

  old=$(get_prop "$cfg" "$CONFIG_VAR")
  new=$(jdbc_url "$copy")
  set_prop "$cfg" "$CONFIG_VAR" "$new"

  echo "      $CONFIG_VAR"
  echo "        was: ${old:-<not set>}"
  echo "        now: $(get_prop "$cfg" "$CONFIG_VAR")"

  # cheap self-check: did the file really end up saying what we intended?
  [ "$(get_prop "$cfg" "$CONFIG_VAR")" = "$new" ] || {
    echo "      WRITE FAILED - $CONFIG_FILE does not contain the new value" >&2
    exit 1
  }
}


cmd_cleanup() {
  local victims main target found=0
  DB_NAME="$1"
  target="${2:-}"
  require_connection
  main=$(main_db)
  victims=$(ask "SELECT datname FROM pg_database
                   WHERE starts_with(datname, '$main-')
                     AND datname <> '$main'
                   ORDER BY datname")
    echo "      Available databases:" >&2
    while IFS= read -r name; do
      [ -n "$name" ] && echo "        - $name" >&2
    done <<< "$victims"

  if [ -z "$target" ]; then
      echo "To drop a database type ./db-tool cleanup $main <database_name>" >&2
      exit 1
  fi

  if [ "$target" = 'all' ]; then
    read -p "Are you sure you want to drop all \"$main-*\" databases? [y/n] " -r choice
    case "$choice" in
      [yY])
        while IFS= read -r name; do
          [ -n "$name" ] || continue
          [ "$name" = "$main" ] && continue
          disconnect_everyone_from "$name"
          dropdb --force --username="$DB_USER" --host="$DB_HOST" --port="$DB_PORT" "$name"
          echo "      dropped \"$name\""
        done <<< "$victims" ;;
      *)
        echo "Aborted."
        exit 0 ;;
    esac
    return 0
  fi

  while IFS= read -r name; do
    if [ "$name" = "$target" ]; then
      found=1
      break
    fi
  done <<< "$victims"

  if [ "$found" -eq 0 ]; then
    echo "FAIL  database \"$target\" is not in the list of removable branch databases" >&2
    exit 1
  fi

  read -p "Are you sure you want to drop \"$target\"? [y/n] " -r choice
  case "$choice" in
    [yY])
      disconnect_everyone_from "$target"
      dropdb --force --username="$DB_USER" --host="$DB_HOST" --port="$DB_PORT" "$target"
      echo "      dropped \"$target\""
      ;;
    *)
      echo "Aborted."
      exit 0
      ;;
  esac
}

cmd_init() {
  local root hooks hook sample main cfg new
  require_connection
  root="$ROOT"
  hooks="$root/.git/hooks"
  hook="$hooks/post-checkout"
  sample="$hook.sample"
  main=$(main_db)
  cfg=$(config_path)
  new=$(jdbc_url "$main")
  set_prop "$cfg" "$CONFIG_VAR" "$new"
  echo "url=$(get_prop "$cfg" "$CONFIG_VAR")"

  if [ -e  "$sample" ] && [ ! -e "$hook" ]; then
    cp "$sample" "$hook"
  fi

  cat > "$hook" <<EOF
#!/usr/bin/env bash
# Installed by db-tool
[ "\$3" = "1" ] || exit 0
"$root/db-tool" copy "${DB_NAME}" || true
EOF
  chmod +x "$hook"
  echo "Hook activated"
}

  COMMAND="${1:-}"
  if [ $# -gt 0 ]; then shift; fi
  ARG1=""
  ARG2=""
main(){
  while [ $# -gt 0 ]; do
    case "$1" in
      --dbname)
        [ "$COMMAND" = init ] || { echo "FAIL  --dbname is only allowed with 'init'" >&2; exit 1; }
        [ $# -ge 2 ]          || { echo "FAIL  --dbname needs a value" >&2; exit 1; }
        DB_NAME="$2"; shift 2 ;;
      --dbname=*)
        [ "$COMMAND" = init ] || { echo "FAIL  --dbname is only allowed with 'init'" >&2; exit 1; }
        DB_NAME="${1#--dbname=}"; shift ;;
      -*)
        echo "FAIL  unexpected option: $1" >&2; exit 1 ;;
      *)
        if   [ -z "$ARG1" ]; then ARG1="$1"
        elif [ -z "$ARG2" ]; then ARG2="$1"
        else echo "FAIL  too many arguments for '$COMMAND'" >&2; exit 1
        fi
        shift ;;
    esac
  done

  case "$COMMAND" in
    init)
      [ -z "$ARG1" ] || { echo "FAIL  unexpected argument '$ARG1' for 'init'" >&2; exit 1; }
      valid_name "$DB_NAME" || exit 1
      cmd_init ;;
    copy)
      [ -z "$ARG2" ] || { echo "FAIL  too many arguments for 'copy'" >&2; exit 1; }
      valid_name "$ARG1" || exit 1
      cmd_copy "$ARG1" ;;
    cleanup)
      valid_name "$ARG1" || exit 1
      cmd_cleanup "$ARG1" "$ARG2" ;;
    *)
      echo "usage: $0 init --dbname <template>" >&2
      echo "       $0 copy <template>" >&2
      echo "       $0 cleanup <template> [<database>|all]" >&2
      exit 1 ;;
  esac
}
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi